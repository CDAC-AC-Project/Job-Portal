# Copy to .env and fill in before running `docker compose up`.

# Where this stack is actually reachable from a browser - a VM's external IP, or
# a domain. Leave unset for local `docker compose up` (defaults to localhost).
# Vite bakes this into the frontend's JS at build time, and the gateway's CORS
# allowlist is derived from it too - both need a rebuild if this ever changes.
PUBLIC_HOST=

# Must be identical for auth-user-service and api-gateway - the gateway validates
# tokens the auth service issues, so a mismatch fails every request as unauthorized.
JWT_SECRET=

# Shared MySQL root password (auth_db, profile_db, jobs_db, Application_db all
# live in the one mysql container, auto-created on first connect).
MYSQL_PASSWORD=

# SQL Server 'sa' password, used by the sqlserver container and NotificationService.
SA_PASSWORD=

# Auth_User-Service sends verification/reset-password emails through this account.
MAIL_USERNAME=
MAIL_PASSWORD=

# Profile-Service resume/profile-image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:5173
